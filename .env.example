# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — NEVER expose to the client; server-side pipeline scripts only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OS Data Hub — https://osdatahub.os.uk (free tier, up to £1,000/month)
# Leave blank to use OpenStreetMap/MapTiler tiles as fallback
OS_DATA_HUB_API_KEY=

# HMLR Use Land and Property Data — required for INSPIRE download pipeline
# Register at: https://use-land-property-data.service.gov.uk
HMLR_API_KEY=

# Nominatim geocoding — no API key needed for standard usage
# Set your app name and contact email for the User-Agent header (required by Nominatim policy)
NOMINATIM_USER_AGENT=LandGrabber/1.0 (richard.sutcliffe@gmail.com)
